<?xml version="1.0" encoding="UTF-8"?>
<!--
  Operational log (FR-030, research R-16): structured JSON lines on stderr only, because stdout
  carries the MCP stdio protocol. Secrets are scrubbed by ScrubbingJsonEncoder. The root level is
  set from the configuration's logLevel at startup (LogLevels.apply).
-->
<configuration>
    <!-- Logback's own warnings and errors go to stderr, never to stdout (the protocol stream);
         INFO statuses are not printed (OnErrorConsoleStatusListener would print them all) -->
    <statusListener class="de.dadecker.inubit.mcp.infra.StderrStatusListener"/>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder class="de.dadecker.inubit.mcp.infra.ScrubbingJsonEncoder">
            <withFormattedMessage>true</withFormattedMessage>
            <withMessage>false</withMessage>
            <withArguments>false</withArguments>
            <withContext>false</withContext>
            <withNanoseconds>false</withNanoseconds>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
