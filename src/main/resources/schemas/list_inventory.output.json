{
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "description": "One entry per resolved {node}, in config order; a failed {node} has only an error",
      "items": {
        "type": "object",
        "required": [
          "node"
        ],
        "properties": {
          "node": {
            "type": "string"
          },
          "collectedAt": {
            "type": "string",
            "description": "ISO-8601: when the (cached) inventory data was collected; present whenever page/item is"
          },
          "usageComplete": {
            "type": "boolean",
            "description": "Modules only: true if every technical workflow of the owner could be read for the usage (workflows/workflowCount); if false, an empty usage does not mean unused"
          },
          "page": {
            "$ref": "#/$defs/Page"
          },
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Page": {
      "type": "object",
      "required": [
        "items",
        "offset",
        "limit",
        "totalIsLowerBound",
        "truncated"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryItem"
          }
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "All matches; absent only if INUBIT cannot report it"
        },
        "totalIsLowerBound": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean",
          "description": "Items or text inside items were cut"
        },
        "nextOffset": {
          "type": "integer",
          "minimum": 0,
          "description": "Offset of the next page, if there is one"
        }
      },
      "additionalProperties": false
    },
    "InventoryItem": {
      "type": "object",
      "required": [
        "node",
        "kind",
        "name",
        "type",
        "group",
        "owner"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "DIAGRAM",
            "MODULE"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Diagram type (technical, bpd, …) or module plugin type (e.g. XSLT Converter)"
        },
        "group": {
          "type": "string",
          "description": "INUBIT diagram group, or module group (= plugin type); not the configured {group}"
        },
        "owner": {
          "type": "string",
          "description": "Owning Workbench user or user group (inventory.owner)"
        },
        "active": {
          "type": "boolean",
          "description": "Modules only (IsActive)"
        },
        "lastChange": {
          "type": "string",
          "description": "Modules only: ISO-8601 time of the last content change (LastUpdate), not the last check-in"
        },
        "workflows": {
          "type": "array",
          "description": "Modules only: technical workflows that use the module (their workflow nodes name it, or the connector is bound to it), sorted by name; at most 5 listed, see workflowCount. Empty = not used, if usageComplete",
          "items": {
            "type": "string"
          }
        },
        "workflowCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Modules only: number of all using workflows"
        }
      },
      "additionalProperties": false
    },
    "ToolError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "likelyCause",
        "nextStep"
      ],
      "properties": {
        "code": {
          "enum": [
            "TARGET_UNKNOWN",
            "UNREACHABLE",
            "TIMEOUT",
            "TLS_ERROR",
            "AUTH_FAILED",
            "FORBIDDEN",
            "MAINTENANCE_MODE",
            "NOT_FOUND",
            "INVALID_INPUT",
            "CLI_UNAVAILABLE",
            "UNEXPECTED_RESPONSE",
            "WRITE_DISABLED",
            "PRODUCTION_PROTECTED",
            "CONFIRMATION_REQUIRED",
            "CONFIRMATION_INVALID",
            "PRECONDITION_FAILED",
            "UNSUPPORTED_VERSION",
            "NOT_CONFIGURED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "likelyCause": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
