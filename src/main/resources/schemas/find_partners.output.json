{
  "type": "object",
  "required": [
    "callId",
    "mode",
    "compared",
    "servers",
    "referencableWorkflows",
    "partners",
    "total",
    "offset",
    "limit",
    "truncated"
  ],
  "properties": {
    "callId": {
      "type": "string",
      "description": "The call id shared by the audit records of this call"
    },
    "mode": {
      "enum": [
        "search",
        "list"
      ],
      "description": "search with a search term, list without"
    },
    "compared": {
      "type": "boolean",
      "description": "Whether {nodes} were compared"
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Server"
      },
      "description": "One entry per targeted {node}, in config order; a failed {node} has its error and no data"
    },
    "referencableWorkflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "systemDiagram",
          "cloud",
          "workflows"
        ],
        "properties": {
          "systemDiagram": {
            "$ref": "#/$defs/DiagramRef"
          },
          "cloud": {
            "type": "string"
          },
          "moduleId": {
            "type": "string",
            "description": "The cloud's module id; only when two communication clouds of one system diagram share a name"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "description": "The technical workflows the entries of a communication cloud can reference, per cloud that contributed a partner"
    },
    "partners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Partner"
      },
      "description": "The matching partners in export order"
    },
    "similarValues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Only when a search matched nothing: up to five similar non-secret partner Ids and names"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of matching partners"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "nextOffset": {
      "type": "integer",
      "minimum": 1,
      "description": "The offset of the next page; absent on the last page"
    },
    "truncated": {
      "type": "boolean",
      "description": "Whether the result was cut to stay within the size bound"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DiagramRef": {
      "type": "object",
      "required": [
        "name",
        "diagramGroup"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "diagramGroup": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Server": {
      "type": "object",
      "required": [
        "node",
        "group",
        "systemDiagramsRead",
        "withoutPartnerManagement",
        "unreadableDiagrams",
        "warnings"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "description": "The owner whose system diagrams were read"
        },
        "collectedAt": {
          "type": "string",
          "description": "ISO-8601: when the (cached) data was collected"
        },
        "fromCache": {
          "type": "boolean"
        },
        "systemDiagramsRead": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "diagramGroup",
              "clouds"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "diagramGroup": {
                "type": "string"
              },
              "clouds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "cloud",
                    "partners"
                  ],
                  "properties": {
                    "cloud": {
                      "type": "string"
                    },
                    "moduleId": {
                      "type": "string",
                      "description": "The cloud's module id; only when two communication clouds of one system diagram share a name"
                    },
                    "partners": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Every system diagram read, with each communication cloud and its number of partners; no clouds for a system diagram without Partner Management"
        },
        "withoutPartnerManagement": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagramRef"
          },
          "description": "The system diagrams read that hold no Partner Management"
        },
        "unreadableDiagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "systemDiagram",
              "code",
              "message"
            ],
            "properties": {
              "systemDiagram": {
                "$ref": "#/$defs/DiagramRef"
              },
              "code": {
                "$ref": "#/$defs/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": "System diagrams that could not be read; the other system diagrams of the {node} are answered"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Version warnings and references that do not resolve"
        },
        "error": {
          "$ref": "#/$defs/ToolError"
        }
      },
      "additionalProperties": false
    },
    "Setting": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "masked": {
          "const": true,
          "description": "A secret: its value is never shown"
        },
        "set": {
          "type": "boolean",
          "description": "Only for a masked value: whether it is set"
        }
      },
      "additionalProperties": false,
      "description": "A field or setting: value if shown, else masked with set"
    },
    "Partner": {
      "type": "object",
      "required": [
        "systemDiagram",
        "cloud",
        "fields",
        "maskedCount",
        "entries"
      ],
      "properties": {
        "systemDiagram": {
          "$ref": "#/$defs/DiagramRef"
        },
        "cloud": {
          "type": "string",
          "description": "Module name of the communication cloud"
        },
        "moduleId": {
          "type": "string",
          "description": "The cloud's module id; only when two communication clouds of one system diagram share a name"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Setting"
          }
        },
        "maskedCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of masked values of the partner"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "description": "The protocol entries in export order, never merged"
        }
      },
      "additionalProperties": false
    },
    "Entry": {
      "type": "object",
      "required": [
        "protocol",
        "workflow",
        "protocolSettings",
        "additionalParameters"
      ],
      "properties": {
        "protocol": {
          "type": "string"
        },
        "workflow": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "unresolved": {
              "const": true
            }
          },
          "additionalProperties": false,
          "description": "The referenced technical workflow; name null and unresolved true if the reference does not resolve"
        },
        "format": {
          "type": "string"
        },
        "protocolSettings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Setting"
          }
        },
        "additionalParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Setting"
          }
        }
      },
      "additionalProperties": false
    },
    "ErrorCode": {
      "enum": [
        "TARGET_UNKNOWN",
        "UNREACHABLE",
        "TIMEOUT",
        "TLS_ERROR",
        "AUTH_FAILED",
        "FORBIDDEN",
        "MAINTENANCE_MODE",
        "NOT_FOUND",
        "INVALID_INPUT",
        "CLI_UNAVAILABLE",
        "UNEXPECTED_RESPONSE",
        "WRITE_DISABLED",
        "PRODUCTION_PROTECTED",
        "CONFIRMATION_REQUIRED",
        "CONFIRMATION_INVALID",
        "PRECONDITION_FAILED",
        "UNSUPPORTED_VERSION",
        "NOT_CONFIGURED",
        "INTERNAL"
      ]
    },
    "ToolError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "likelyCause",
        "nextStep"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "likelyCause": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
