{
  "type": "object",
  "required": ["node", "inubitNode", "total", "truncated", "nodes", "hints", "warnings"],
  "properties": {
    "node": { "type": "string" },
    "inubitNode": { "type": "string", "description": "The INUBIT cluster member that answered" },
    "total": { "type": "integer", "minimum": 0, "description": "All cluster members INUBIT returned" },
    "truncated": { "type": "boolean", "description": "true when nodes lists only the first 200 members" },
    "nodes": {
      "type": "array",
      "maxItems": 200,
      "description": "The cluster members in INUBIT's order",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["ACTIVE", "MAINTENANCE", "OFFLINE", "UNKNOWN"] },
          "rawStatus": { "type": "string", "description": "The status text INUBIT returned; only for an unknown one" },
          "version": { "type": "string" },
          "zone": { "type": "string" },
          "nodeId": { "type": "string" },
          "uptime": { "type": "string", "description": "ISO-8601 duration" },
          "uptimeSeconds": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "details": {
      "description": "Only with nodeName: the member's details, or why INUBIT could not deliver them",
      "oneOf": [
        {
          "type": "object",
          "required": ["node", "available", "pairs", "truncated"],
          "properties": {
            "node": { "type": "string" },
            "available": { "const": true },
            "pairs": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "required": ["key", "value"],
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string", "description": "Masked; at most 2,000 characters" },
                  "cut": { "const": true, "description": "Present when the value was cut" }
                },
                "additionalProperties": false
              }
            },
            "truncated": { "type": "boolean", "description": "true when only part of the details was returned" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["node", "available", "reason"],
          "properties": {
            "node": { "type": "string" },
            "available": { "const": false },
            "reason": { "type": "string", "description": "Masked; at most 200 characters" }
          },
          "additionalProperties": false
        }
      ]
    },
    "hints": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
