{
  "type": "object",
  "required": ["node", "action", "reason"],
  "properties": {
    "node": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}/[a-z0-9][a-z0-9-]{0,31}$",
      "description": "Id of exactly one {node} (`<{group}>/<{node}>`); {group} ids are rejected"
    },
    "action": {
      "enum": ["setMaintenance", "setReadiness", "setTrace", "setTraceLevel", "triggerMidnightTask", "deleteErrorProcesses"],
      "description": "The change; each action takes only its own fields"
    },
    "on": {
      "type": "boolean",
      "description": "true switches on, false off; required for and only allowed with `setMaintenance` and `setTrace`"
    },
    "executeQueued": {
      "type": "boolean",
      "description": "Sent as -eq: whether the processes already queued are still executed in maintenance mode; only with `setMaintenance` and `on: true`"
    },
    "ready": {
      "type": "boolean",
      "description": "true: READY, false: NOT READY; required for and only allowed with `setReadiness`"
    },
    "level": {
      "enum": ["error", "warn", "info", "debug"],
      "description": "The trace level; required for and only allowed with `setTraceLevel`"
    },
    "reason": {
      "type": "string",
      "pattern": "^[^\\r\\n]{1,500}$",
      "description": "Why the change is made, one line of 1 to 500 characters; stored in the audit log"
    },
    "confirmationCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "The code from the preview of the first call, with the same inputs; executes the change"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": { "action": { "const": "setMaintenance" } },
      "required": ["on"],
      "not": { "anyOf": [{ "required": ["ready"] }, { "required": ["level"] }] },
      "anyOf": [{ "not": { "required": ["executeQueued"] } }, { "properties": { "on": { "const": true } } }]
    },
    {
      "properties": { "action": { "const": "setReadiness" } },
      "required": ["ready"],
      "not": { "anyOf": [{ "required": ["on"] }, { "required": ["executeQueued"] }, { "required": ["level"] }] }
    },
    {
      "properties": { "action": { "const": "setTrace" } },
      "required": ["on"],
      "not": { "anyOf": [{ "required": ["executeQueued"] }, { "required": ["ready"] }, { "required": ["level"] }] }
    },
    {
      "properties": { "action": { "const": "setTraceLevel" } },
      "required": ["level"],
      "not": { "anyOf": [{ "required": ["on"] }, { "required": ["executeQueued"] }, { "required": ["ready"] }] }
    },
    {
      "properties": { "action": { "enum": ["triggerMidnightTask", "deleteErrorProcesses"] } },
      "not": { "anyOf": [{ "required": ["on"] }, { "required": ["executeQueued"] }, { "required": ["ready"] }, { "required": ["level"] }] }
    }
  ]
}
