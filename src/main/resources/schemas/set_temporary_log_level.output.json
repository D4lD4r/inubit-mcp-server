{
  "type": "object",
  "description": "Either the preview of the first step (challenge) or the result of the execution (result); refusals are tool errors",
  "properties": {
    "challenge": { "$ref": "#/$defs/ConfirmationChallenge" },
    "result": { "$ref": "#/$defs/LogLevelResult" }
  },
  "additionalProperties": false,
  "oneOf": [
    { "required": ["challenge"] },
    { "required": ["result"] }
  ],
  "$defs": {
    "ConfirmationChallenge": {
      "type": "object",
      "description": "Nothing was changed; call the tool again with confirmationCode before expiresAt to execute",
      "required": ["confirmationCode", "expiresAt", "preview", "message"],
      "properties": {
        "confirmationCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "description": "One-time code, bound to this {node}, its loggers, level and duration"
        },
        "expiresAt": { "type": "string", "description": "ISO-8601 UTC" },
        "preview": { "$ref": "#/$defs/Preview" },
        "message": { "type": "string", "description": "What to do next" }
      },
      "additionalProperties": false
    },
    "Preview": {
      "type": "object",
      "required": ["node", "inubitNode", "loggers", "durationMinutes"],
      "properties": {
        "node": { "type": "string" },
        "inubitNode": { "type": "string", "description": "The INUBIT node that answered" },
        "loggers": { "type": "array", "items": { "$ref": "#/$defs/Logger" } },
        "durationMinutes": { "type": "integer" },
        "openLease": {
          "anyOf": [{ "$ref": "#/$defs/LeaseSummary" }, { "type": "null" }],
          "description": "The lease open for this {node}; the change merges into it; absent when none is open"
        }
      },
      "additionalProperties": false
    },
    "LogLevelResult": {
      "type": "object",
      "required": ["node", "inubitNode", "outcome", "loggers", "message", "auditId", "warnings"],
      "properties": {
        "node": { "type": "string" },
        "inubitNode": { "type": "string", "description": "The INUBIT node that answered" },
        "outcome": {
          "enum": ["EXECUTED", "FAILED"],
          "description": "EXECUTED: the levels are raised; FAILED: a StartCLI run failed and the node was reset at once (see message)"
        },
        "leaseId": { "type": "string", "description": "The lease recorded, merged into or ended" },
        "loggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Logger" },
          "description": "Every logger of the lease"
        },
        "expiresAt": {
          "type": "string",
          "description": "ISO-8601 UTC: when the MCP server resets the node; absent when the lease is no longer open"
        },
        "message": { "type": "string" },
        "auditId": { "type": "string", "description": "Id of the execution's audit records" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Logger": {
      "type": "object",
      "required": ["name", "level"],
      "properties": {
        "name": { "type": "string" },
        "level": { "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"] }
      },
      "additionalProperties": false
    },
    "LeaseSummary": {
      "type": "object",
      "required": ["leaseId", "inubitNode", "loggers", "setAt", "expiresAt", "state"],
      "properties": {
        "leaseId": { "type": "string" },
        "inubitNode": { "type": "string" },
        "loggers": { "type": "array", "items": { "$ref": "#/$defs/Logger" } },
        "setAt": { "type": "string", "description": "ISO-8601 UTC" },
        "expiresAt": { "type": "string", "description": "ISO-8601 UTC" },
        "state": {
          "enum": ["ACTIVE", "RESET_FAILED"],
          "description": "RESET_FAILED: the automatic reset failed; the level may still be raised"
        },
        "lastAttempt": {
          "type": "object",
          "description": "The last reset attempt that did not end the lease",
          "required": ["at", "outcome"],
          "properties": {
            "at": { "type": "string", "description": "ISO-8601 UTC" },
            "outcome": { "type": "string" },
            "code": { "type": "string" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
