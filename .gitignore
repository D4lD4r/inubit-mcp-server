# Build output
target/

# IDEs
*.iml
.idea/
.vscode/
# Eclipse / Java language server (VS Code Java, Claude's LSP) project files
.classpath
.project
.settings/
.factorypath

# Logs
*.log

# Python
__pycache__/
*.pyc

# Local release-check files (never commit: they name customer values)
.denylist
.neutralize-map
.synthetic-map
.identifier-allowlist

# Spec Kit: Das Gerüst unter .specify/ (Skripte, Templates, Workflows, Manifeste, Erweiterungen) ist
# generiert und wird von `specify integration upgrade claude` gepflegt (nächtliche Routine
# nightly-tooling-update-check). Im Repo bleibt nur die Verfassung.
# Fehlt das Gerüst (frischer Klon, oder Git hat es beim Wechsel von einem Commit gelöscht, in dem es
# noch versioniert war, also vor 32d6c06), einmal:
#   specify init --here --force --integration claude --script sh --non-interactive --ignore-agent-tools
#   specify extension add git
#   git restore .claude/skills    (die Erweiterung schreibt die versionierten speckit-git-* Skills neu)
#   dann die neuen .claude/skills/speckit-<Kern-Skills> löschen; sie liegen global in ~/.claude/skills
# Die Verfassung bleibt dabei unverändert (geprüft mit Spec Kit 1.2.4). Bleiben Skripte oder Templates
# auf altem Stand, hilft `specify integration upgrade claude --force`.
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md
